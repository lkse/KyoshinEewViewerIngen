<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:KyoshinEewViewer.Localization"
             xmlns:triggers="clr-namespace:KyoshinEewViewer.Services.Workflows.BuiltinTriggers"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="triggers:UpdateAvailableTrigger" x:CompileBindings="True"
             x:Class="KyoshinEewViewer.Services.Workflows.BuiltinTriggers.UpdateAvailableTriggerControl">
    <CheckBox Content="{loc:Localize WorkflowTriggerUpdateContinuous}" IsChecked="{Binding IsContinuous}"
              ToolTip.Tip="{loc:Localize WorkflowTriggerUpdateContinuousDescription}" />
</UserControl>
