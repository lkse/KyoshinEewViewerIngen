<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		     xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:loc="using:KyoshinEewViewer.Localization"
             xmlns:wf="clr-namespace:KyoshinEewViewer.Series.Tsunami.Workflow;assembly=KyoshinEewViewer"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="350"
             x:DataType="wf:TsunamiInformationTrigger" x:CompileBindings="True"
             x:Class="KyoshinEewViewer.Series.Tsunami.Workflow.TsunamiInformationTriggerControl">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{loc:Localize WorkflowTriggerTsunamiIssuedLevel}" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{x:Static wf:TsunamiInformationTrigger.LevelNames}" SelectedValue="{Binding Level}" SelectedValueBinding="{ReflectionBinding Key}" DisplayMemberBinding="{ReflectionBinding Value}" />
        </StackPanel>
        <CheckBox Content="{loc:Localize WorkflowTriggerTsunamiLevelMatchOnly}" IsChecked="{Binding IsExact}"
                  ToolTip.Tip="{loc:Localize WorkflowTriggerLevelMatchDescription}"/>

        <WrapPanel>
            <CheckBox IsChecked="{Binding EnableIssued}" Content="{loc:Localize WorkflowTriggerTsunamiIssued}" Margin="0,2,10,2"
                      ToolTip.Tip="{loc:Localize WorkflowTriggerTsunamiIssuedDescription}" />
            <CheckBox IsChecked="{Binding EnableUpgraded}" Content="{loc:Localize WorkflowTriggerTsunamiUpgraded}" Margin="0,2,10,2"
                      ToolTip.Tip="{loc:Localize WorkflowTriggerTsunamiUpgradedDescription}" />
            <CheckBox IsChecked="{Binding EnableDowngraded}" Content="{loc:Localize WorkflowTriggerTsunamiDowngraded}" Margin="0,2,10,2"
                      ToolTip.Tip="{loc:Localize WorkflowTriggerTsunamiDowngradedDescription}" />
            <CheckBox IsChecked="{Binding EnableUpdated}" Content="{loc:Localize WorkflowTriggerTsunamiOtherUpdate}" Margin="0,2,10,2"
                      ToolTip.Tip="{loc:Localize WorkflowTriggerTsunamiOtherUpdateDescription}" />
        </WrapPanel>
    </StackPanel>
</UserControl>
