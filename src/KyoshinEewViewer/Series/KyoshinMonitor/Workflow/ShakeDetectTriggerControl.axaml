<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		     xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:loc="using:KyoshinEewViewer.Localization"
             xmlns:wf="clr-namespace:KyoshinEewViewer.Series.KyoshinMonitor.Workflow;assembly=KyoshinEewViewer"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="wf:ShakeDetectTrigger" x:CompileBindings="True"
             x:Class="KyoshinEewViewer.Series.KyoshinMonitor.Workflow.ShakeDetectTriggerControl">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{loc:Localize WorkflowTriggerShakeDetectionLevel}" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{x:Static wf:ShakeDetectTrigger.LevelNames}" SelectedValue="{Binding Level}" SelectedValueBinding="{ReflectionBinding Key}" DisplayMemberBinding="{ReflectionBinding Value}" />
        </StackPanel>
        <CheckBox Content="{loc:Localize WorkflowTriggerShakeLevelMatchOnly}" IsChecked="{Binding IsExact}"
                  ToolTip.Tip="{loc:Localize WorkflowTriggerLevelMatchDescription}"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="{loc:Localize WorkflowTriggerShakePeakRegionExpansion}" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{x:Static wf:ShakeDetectTrigger.PeakRegionExpansionModeNames}" SelectedValue="{Binding PeakRegionExpansionMode}" SelectedValueBinding="{ReflectionBinding Key}" DisplayMemberBinding="{ReflectionBinding Value}"
                      ToolTip.Tip="{loc:Localize WorkflowTriggerShakePeakRegionExpansionDescription}" />
        </StackPanel>
    </StackPanel>
</UserControl>
