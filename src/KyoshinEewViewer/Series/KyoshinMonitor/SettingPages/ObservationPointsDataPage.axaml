<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:loc="using:KyoshinEewViewer.Localization"
			 xmlns:vm="using:KyoshinEewViewer.Series.KyoshinMonitor.SettingPages"
			 xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="600"
			 x:DataType="vm:ObservationPointsDataPageViewModel"
             x:Class="KyoshinEewViewer.Series.KyoshinMonitor.SettingPages.ObservationPointsDataPage">
	<UserControl.Styles>
		<Style Selector="Label">
			<Setter Property="Foreground" Value="{DynamicResource MainForegroundColor}" />
		</Style>
		<Style Selector="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="ui|FASettingsExpander">
			<Setter Property="Margin" Value="10,3,10,0" />
		</Style>
	</UserControl.Styles>
	<ScrollViewer>
		<StackPanel>
			<ui:FASettingsExpander Header="{loc:Localize ObservationPointsAutoUpdate}" Description="{loc:Localize ObservationPointsAutoUpdateDescription}">
				<ui:FASettingsExpander.IconSource>
					<ui:FAFontIconSource Glyph="&#xf021;" FontFamily="{StaticResource IconFont}" />
				</ui:FASettingsExpander.IconSource>
				<ui:FASettingsExpander.Footer>
					<ToggleSwitch IsChecked="{Binding Config.KyoshinMonitor.AutoUpdateObservationPoints}" OnContent="{loc:Localize CommonEnabled}" OffContent="{loc:Localize CommonDisabled}" />
				</ui:FASettingsExpander.Footer>
			</ui:FASettingsExpander>

			<TextBlock Text="{loc:Localize ObservationPointsCurrentData}" FontWeight="Bold" Margin="10,20,10,5" />
			<ui:FASettingsExpander Header="{loc:Localize ObservationPointsDataVersion}" Description="{loc:Localize ObservationPointsDataVersionDescription}">
				<ui:FASettingsExpander.IconSource>
					<ui:FAFontIconSource Glyph="&#xf05a;" FontFamily="{StaticResource IconFont}" />
				</ui:FASettingsExpander.IconSource>
				<ui:FASettingsExpander.Footer>
					<TextBlock Text="{Binding DataVersion}" FontWeight="SemiBold" />
				</ui:FASettingsExpander.Footer>
			</ui:FASettingsExpander>

			<ui:FASettingsExpander Header="{loc:Localize ObservationPointsPackedAt}" Footer="{Binding PackedAt}">
				<ui:FASettingsExpander.IconSource>
					<ui:FAFontIconSource Glyph="&#xf073;" FontFamily="{StaticResource IconFont}" />
				</ui:FASettingsExpander.IconSource>
			</ui:FASettingsExpander>

			<ui:FASettingsExpander Header="{loc:Localize ObservationPointsDataSource}">
				<ui:FASettingsExpander.IconSource>
					<ui:FAFontIconSource Glyph="&#xf1c0;" FontFamily="{StaticResource IconFont}" />
				</ui:FASettingsExpander.IconSource>
				<ui:FASettingsExpander.Footer>
					<TextBlock Text="{Binding Source}" FontSize="12" />
				</ui:FASettingsExpander.Footer>
			</ui:FASettingsExpander>

			<ui:FASettingsExpander Header="{loc:Localize ObservationPointsCount}" Footer="{loc:LocalizeFormat ObservationPointsCountFormat, Value={Binding ObservationPointsCount}}">
				<ui:FASettingsExpander.IconSource>
					<ui:FAFontIconSource Glyph="&#xf279;" FontFamily="{StaticResource IconFont}" />
				</ui:FASettingsExpander.IconSource>
			</ui:FASettingsExpander>

			<TextBlock Text="{loc:Localize ObservationPointsUpdate}" FontWeight="Bold" Margin="10,20,10,5" />
			<ui:FASettingsExpander Header="{loc:Localize ObservationPointsManualUpdate}" Description="{loc:Localize ObservationPointsManualUpdateDescription}">
				<ui:FASettingsExpander.IconSource>
					<ui:FAFontIconSource Glyph="&#xf2f1;" FontFamily="{StaticResource IconFont}" />
				</ui:FASettingsExpander.IconSource>
				<ui:FASettingsExpander.Footer>
					<Button Content="{loc:Localize ObservationPointsUpdate}" Command="{Binding ManualUpdateCommand}" IsEnabled="{Binding !IsUpdating}" />
				</ui:FASettingsExpander.Footer>

				<StackPanel Spacing="5" Margin="0,5">
					<TextBlock Text="{Binding UpdateStatus}" FontSize="12" Foreground="{DynamicResource SystemAccentColor}" />
					<TextBlock Text="{loc:Localize ObservationPointsRestartRequired}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
				</StackPanel>
			</ui:FASettingsExpander>
		</StackPanel>
	</ScrollViewer>
</UserControl>
