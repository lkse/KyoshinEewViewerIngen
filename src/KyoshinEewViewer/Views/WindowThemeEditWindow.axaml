<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:loc="using:KyoshinEewViewer.Localization"
        xmlns:converter="clr-namespace:KyoshinEewViewer.Converters;assembly=KyoshinEewViewer"
        xmlns:models="clr-namespace:KyoshinEewViewer.Core.Models;assembly=KyoshinEewViewer.Core"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="800" Width="500" Height="600"
        x:Class="KyoshinEewViewer.Views.WindowThemeEditWindow"
        x:DataType="models:WindowTheme"
        d:DataContext="{x:Static models:WindowTheme.Dark}"
        Title="{loc:Localize WindowThemeEditWindowTitle}" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MainBackgroundColor}" Foreground="{DynamicResource MainForegroundColor}">
    <Window.Styles>
        <Style Selector="Label">
            <Setter Property="Foreground" Value="{DynamicResource MainForegroundColor}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="ui|FASettingsExpander">
            <Setter Property="Margin" Value="10,3,10,0" />
        </Style>
    </Window.Styles>
    <Window.Resources>
        <converter:ColorConverter x:Key="ColorConverter" />
    </Window.Resources>

    <Grid RowDefinitions="auto,*">
        <StackPanel Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock Text="{loc:Localize ThemeEditEditingTheme}" FontSize="18" />
            <TextBlock x:Name="themeDetailText" FontSize="12" Foreground="{DynamicResource SubForegroundColor}" />
        </StackPanel>
        <StackPanel Spacing="5" Orientation="Horizontal" Margin="10" HorizontalAlignment="Right">
            <Button x:Name="rollbackButton" VerticalAlignment="Stretch"
                    ToolTip.Tip="{loc:Localize ThemeEditRestore}" Padding="11">
                <ui:FASymbolIcon Symbol="Undo" FontSize="18" />
            </Button>
            <Button x:Name="saveButton" VerticalAlignment="Stretch" Classes="accent"
                    ToolTip.Tip="{loc:Localize ThemeEditSave}" Padding="10">
                <ui:FASymbolIcon Symbol="Save" FontSize="20" />
            </Button>
        </StackPanel>
        
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <ui:FASettingsExpander Header="{loc:Localize ThemeEditThemeName}">
                    <ui:FASettingsExpander.IconSource>
                        <ui:FAFontIconSource Glyph="&#xf5b7;" FontFamily="{StaticResource IconFont}" />
                    </ui:FASettingsExpander.IconSource>
                    <ui:FASettingsExpander.Footer>
                        <TextBox Text="{Binding Name}" Width="200" />
                    </ui:FASettingsExpander.Footer>
                </ui:FASettingsExpander>
                <ui:FASettingsExpander Header="{loc:Localize WindowThemeWholeWindow}">
                    <ui:FASettingsExpander.IconSource>
                        <ui:FAFontIconSource Glyph="&#xf2d0;" FontFamily="{StaticResource IconFont}" />
                    </ui:FASettingsExpander.IconSource>
                    
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeTitleSidebarColor}" Description="{loc:Localize WindowThemeTitleSidebarColorDescription}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TitleBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeIsDark}"
                                             Description="{loc:Localize WindowThemeIsDarkDescription}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ToggleSwitch OnContent="{loc:Localize CommonEnable}" OffContent="{loc:Localize CommonDisable}" IsChecked="{Binding IsDark}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeMainBackground}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding MainBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeMainForeground}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding ForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeSubForeground}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding SubForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeEmphasisForeground}" Description="{loc:Localize WindowThemeEmphasisForegroundDescription}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EmphasisForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeWarningForeground}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding WarningForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeWarningSubForeground}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding WarningSubForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeWarningBackground}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding WarningBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </ui:FASettingsExpander>

                <ui:FASettingsExpander Header="{loc:Localize WindowThemeWidget}">
                    <ui:FASettingsExpander.IconSource>
                        <ui:FAFontIconSource Glyph="&#xf2d2;" FontFamily="{StaticResource IconFont}" />
                    </ui:FASettingsExpander.IconSource>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Grid Margin="5" RowDefinitions="24,*">
                            <Border Grid.Row="0" Background="{DynamicResource DockTitleBackgroundColor}" CornerRadius="4,4,0,0">
                                <TextBlock Text="{loc:Localize SetupWizardNormalWidgetTitle}" Margin="10,0" FontSize="18" Foreground="{DynamicResource SubForegroundColor}" HorizontalAlignment="Center" />
                            </Border>
                            <Border Grid.Row="1" Background="{DynamicResource DockBackgroundColor}" CornerRadius="0,0,4,4" ClipToBounds="True">
                                <TextBlock Margin="5" Text="{loc:Localize SetupWizardNormalWidgetContent}" />
                            </Border>
                        </Grid>
                        <Grid Margin="5" RowDefinitions="24,*">
                            <Border Grid.Row="0" Background="{DynamicResource DockWarningTitleBackgroundColor}" CornerRadius="4,4,0,0">
                                <TextBlock Text="{loc:Localize SetupWizardEmergencyWidgetTitle}" Margin="10,0" FontSize="18" Foreground="{DynamicResource WarningSubForegroundColor}" HorizontalAlignment="Center" />
                            </Border>
                            <Border Grid.Row="1" Background="{DynamicResource DockWarningBackgroundColor}" CornerRadius="0,0,4,4"
                                    ClipToBounds="True">
                                <TextBlock Text="{loc:Localize SetupWizardEmergencyWidgetContent}" Margin="10,5" Foreground="{DynamicResource WarningForegroundColor}"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                    
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeDockBackground}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding DockBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeDockTitleBackground}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding DockTitleBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeDockWarningBackground}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding DockWarningBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeDockWarningTitleBackground}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding DockWarningTitleBackgroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </ui:FASettingsExpander>

                <ui:FASettingsExpander Header="{loc:Localize WindowThemeMap}">
                    <ui:FASettingsExpander.IconSource>
                        <ui:FAFontIconSource Glyph="&#xf5a0;" FontFamily="{StaticResource IconFont}" />
                    </ui:FASettingsExpander.IconSource>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{loc:Localize SetupWizardMapJapan}" />
                            <Border BorderBrush="{DynamicResource MainForegroundColor}"
                                    Background="{DynamicResource BackgroundColor}" BorderThickness="1"
                                    HorizontalAlignment="Center" Margin="5">
                                <Canvas Width="120" Height="120">
                                    <Ellipse Canvas.Top="10" Canvas.Left="10" Width="100" Height="100" Stroke="{DynamicResource LandStrokeColor}" StrokeThickness="{DynamicResource LandStrokeThickness}" Fill="{DynamicResource LandColor}" />
                                    <Line Canvas.Top="10" Canvas.Left="10" StartPoint="85,15" EndPoint="15,85" Stroke="{DynamicResource PrefStrokeColor}" StrokeThickness="{DynamicResource PrefStrokeThickness}" />
                                    <Line Canvas.Top="10" Canvas.Left="10" StartPoint="15,15" EndPoint="85,85" Stroke="{DynamicResource AreaStrokeColor}" StrokeThickness="{DynamicResource AreaStrokeThickness}" />
                                </Canvas>
                            </Border>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{loc:Localize SetupWizardMapOther}" />
                            <Border BorderBrush="{DynamicResource MainForegroundColor}"
                                    Background="{DynamicResource BackgroundColor}" BorderThickness="1"
                                    HorizontalAlignment="Center" Margin="5">
                                <Canvas Width="120" Height="120">
                                    <Ellipse Canvas.Top="10" Canvas.Left="10" Width="100" Height="100" Fill="{DynamicResource OverseasLandColor}" />
                                </Canvas>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeOverseasLandColor}" Description="{loc:Localize WindowThemeOverseasLandColorDescription}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding OverseasLandColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeLandColor}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding LandColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeCoastlineColor}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding LandStrokeColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeCoastlineThickness}" Description="{loc:Localize WindowThemeStrokeThicknessDescription}">
                        <ui:FASettingsExpanderItem.Footer>
                            <DockPanel MinWidth="250">
                                <TextBlock Text="{Binding LandStrokeThickness, StringFormat={}{0:0.00}}"
                                            TextAlignment="Right" VerticalAlignment="Center" Width="45" DockPanel.Dock="Right" />
                                <Slider Minimum="0" Maximum="3" Value="{Binding LandStrokeThickness}"
                                        TickFrequency="0.02" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            </DockPanel>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemePrefBorderColor}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding PrefStrokeColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemePrefBorderThickness}" Description="{loc:Localize WindowThemeStrokeThicknessDescription}">
                        <ui:FASettingsExpanderItem.Footer>
                            <DockPanel MinWidth="250">
                                <TextBlock Text="{Binding PrefStrokeThickness, StringFormat={}{0:0.00}}"
                                            TextAlignment="Right" VerticalAlignment="Center" Width="45" DockPanel.Dock="Right" />
                                <Slider Minimum="0" Maximum="3" Value="{Binding PrefStrokeThickness}"
                                        TickFrequency="0.02" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            </DockPanel>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeAreaBorderColor}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding AreaStrokeColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeAreaBorderThickness}" Description="{loc:Localize WindowThemeStrokeThicknessDescription}">
                        <ui:FASettingsExpanderItem.Footer>
                            <DockPanel MinWidth="250">
                                <TextBlock Text="{Binding AreaStrokeThickness, StringFormat={}{0:0.00}}"
                                            TextAlignment="Right" VerticalAlignment="Center" Width="45" DockPanel.Dock="Right" />
                                <Slider Minimum="0" Maximum="3" Value="{Binding AreaStrokeThickness}"
                                        TickFrequency="0.02" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            </DockPanel>
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </ui:FASettingsExpander>

                <ui:FASettingsExpander Header="{loc:Localize SeriesEarthquakeName}">
                    <ui:FASettingsExpander.IconSource>
                        <ui:FAFontIconSource Glyph="&#xf05a;" FontFamily="{StaticResource IconFont}" />
                    </ui:FASettingsExpander.IconSource>
                    
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeHypocenterBorder}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EarthquakeHypocenterBorderColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeHypocenterCenter}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EarthquakeHypocenterColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </ui:FASettingsExpander>

                <ui:FASettingsExpander Header="{loc:Localize SettingEarthquakeEarlyWarning}">
                    <ui:FASettingsExpander.IconSource>
                        <ui:FAFontIconSource Glyph="&#xe3b1;" FontFamily="{StaticResource IconFont}" />
                    </ui:FASettingsExpander.IconSource>
                    
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeEewForecastHypocenterBorder}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EewForecastHypocenterBorderColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeEewForecastHypocenterCenter}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EewForecastHypocenterColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeEewWarningHypocenterBorder}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EewWarningHypocenterBorderColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeEewWarningHypocenterCenter}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EewWarningHypocenterColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeEewHypocenterBlink}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ToggleSwitch OnContent="{loc:Localize CommonEnable}" OffContent="{loc:Localize CommonDisable}" IsChecked="{Binding IsEewHypocenterBlinkAnimation}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeEewForecastPWave}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EewForecastPWaveColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeEewForecastSWave}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EewForecastSWaveColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeEewForecastSWaveGradient}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ToggleSwitch OnContent="{loc:Localize CommonEnable}" OffContent="{loc:Localize CommonDisable}" IsChecked="{Binding IsEewForecastSWaveGradient}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeEewWarningPWave}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EewWarningPWaveColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeEewWarningSWave}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding EewWarningSWaveColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeEewWarningSWaveGradient}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ToggleSwitch OnContent="{loc:Localize CommonEnable}" OffContent="{loc:Localize CommonDisable}" IsChecked="{Binding IsEewWarningSWaveGradient}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </ui:FASettingsExpander>

                <ui:FASettingsExpander Header="{loc:Localize SeriesTsunamiName}">
                    <ui:FASettingsExpander.IconSource>
                        <ui:FAFontIconSource Glyph="&#xe515;" FontFamily="{StaticResource IconFont}" />
                    </ui:FASettingsExpander.IconSource>
                    
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeTsunamiForecastBackground}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TsunamiForecastColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeTsunamiForecastForeground}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TsunamiForecastForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeTsunamiAdvisoryBackground}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TsunamiAdvisoryColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeTsunamiAdvisoryForeground}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TsunamiAdvisoryForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeTsunamiWarningBackground}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TsunamiWarningColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeTsunamiWarningForeground}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TsunamiWarningForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeTsunamiMajorWarningBackground}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TsunamiMajorWarningColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeTsunamiMajorWarningForeground}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding TsunamiMajorWarningForegroundColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </ui:FASettingsExpander>

                <ui:FASettingsExpander Header="{loc:Localize WindowThemeVolcano}" Description="{loc:Localize WindowThemeQzssOnlyDescription}">
                    <ui:FASettingsExpander.IconSource>
                        <ui:FAFontIconSource Glyph="&#xf770;" FontFamily="{StaticResource IconFont}" />
                    </ui:FASettingsExpander.IconSource>
                    
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeAshFallLowBackground}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding AshfallLight, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeAshFallLowForeground}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding AshfallLightForeground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeAshFallModerateBackground}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding AshfallModerate, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeAshFallModerateForeground}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding AshfallModerateForeground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeAshFallHeavyBackground}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding AshfallHeavy, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeAshFallHeavyForeground}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding AshfallHeavyForeground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeFallingDebrisBackground}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding SmallVolcanicBombFall, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeFallingDebrisForeground}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding SmallVolcanicBombFallForeground, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </ui:FASettingsExpander>

                <ui:FASettingsExpander Header="{loc:Localize WindowThemeWeatherWarning}" Description="{loc:Localize WindowThemeQzssOnlyDescription}">
                    <ui:FASettingsExpander.IconSource>
                        <ui:FAFontIconSource Glyph="&#xf0c2;" FontFamily="{StaticResource IconFont}" />
                    </ui:FASettingsExpander.IconSource>

                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeAlertLevel5}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding WeatherWarningLevel5Color, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeAlertLevel4}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding WeatherWarningLevel4Color, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeAlertLevel3}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding WeatherWarningLevel3Color, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeAlertLevel2}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding WeatherWarningLevel2Color, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </ui:FASettingsExpander>

                <ui:FASettingsExpander Header="{loc:Localize WindowThemeMarineWarning}" Description="{loc:Localize WindowThemeQzssOnlyDescription}">
                    <ui:FASettingsExpander.IconSource>
                        <ui:FAFontIconSource Glyph="&#xf773;" FontFamily="{StaticResource IconFont}" />
                    </ui:FASettingsExpander.IconSource>

                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeMarineTyphoonWarning}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding MarineWarningTyphoonColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeMarineStormWarning}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding MarineWarningStormColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeMarineGaleWarning}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding MarineWarningGaleColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>

                    <ui:FASettingsExpanderItem Content="{loc:Localize WindowThemeMarineWindWarning}">
                        <ui:FASettingsExpanderItem.Footer>
                            <ColorPicker Color="{Binding MarineWarningWindColor, Mode=TwoWay, Converter={StaticResource ColorConverter}}" />
                        </ui:FASettingsExpanderItem.Footer>
                    </ui:FASettingsExpanderItem>
                </ui:FASettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
